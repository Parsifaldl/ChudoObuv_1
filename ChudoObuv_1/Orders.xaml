<Window x:Class="ChudoObuv_1.Orders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы - Чудо-обувь"
        Height="520" Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список заказов"
                   FontSize="16" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnAdd"
                    Content="Добавить заказ"
                    Width="140" Height="28"
                    Click="BtnAdd_Click"/>
            <Button x:Name="BtnView"
                    Content="Состав заказа"
                    Width="140" Height="28"
                    Margin="10,0,0,0"
                    Click="BtnView_Click"/>
            <Button x:Name="BtnDelete"
                    Content="Удалить заказ"
                    Width="140" Height="28"
                    Margin="10,0,0,0"
                    Click="BtnDelete_Click"/>
            <TextBlock x:Name="TbNewDateLabel"
                       Text="Новая дата:" VerticalAlignment="Center"
                       Margin="20,0,5,0"
                       Visibility="Collapsed"/>
            <DatePicker x:Name="DpNewDate" Width="140" Height="28"
                        Visibility="Collapsed"/>
            <Button x:Name="BtnEditDate"
                    Content="Изменить дату"
                    Width="140" Height="28"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="BtnEditDate_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="OrdersGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа"
                                    Binding="{Binding IdOrders}"
                                    Width="90"/>
                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding DateText}"
                                    Width="130"/>
                <DataGridTextColumn Header="ФИО клиента"
                                    Binding="{Binding ClientFio}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnClose"
                    Content="Назад"
                    Width="140" Height="32"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>