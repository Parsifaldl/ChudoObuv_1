<Window x:Class="ChudoObuv_1.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо-обувь - Каталог товаров"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderInfo" Grid.Column="0"
               Text="Каталог товаров"
               FontSize="18" FontWeight="Bold"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                VerticalAlignment="Center" Margin="15,0,0,0">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TbSearch" Width="140" Height="28"
                 VerticalContentAlignment="Center"
                 TextChanged="TbSearch_TextChanged"/>
                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                <ComboBox x:Name="CbCategory" Width="140" Height="28"
                  SelectionChanged="CbCategory_SelectionChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                <ComboBox x:Name="CbSort" Width="140" Height="28"
                  SelectionChanged="CbSort_SelectionChanged"/>
            </StackPanel>
        </Grid>
        
        <ListBox Grid.Row="1"
                 x:Name="ProductsList"
                 BorderThickness="0"
                 Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#444" BorderThickness="1" CornerRadius="2"
                            Padding="14" Margin="0,0,0,12"
                            ToolTip="{Binding StockToolTip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                                        <Setter Property="Background" Value="#FFC8E6C9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FFFFCDD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="{Binding Image}"
                                   Width="110" Height="100"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="16,0,8,0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Category}"
                                           FontSize="13" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Stock}"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Composition}"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        MinWidth="160" Margin="8,0,4,0">

                                <TextBlock Text="{Binding PriceText}"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscounted}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding DiscountBadge}"
                                               Foreground="#FFD32F2F"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding OldPriceText}"
                                               Foreground="Gray"
                                               FontSize="13"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding NewPriceText}"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>