<Window x:Class="ChudoObuv_1.ProductViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр товара - Чудо-обувь"
        Height="580" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ProductImage"
                   Grid.Column="0"
                   Width="160" Height="160"
                   Stretch="Uniform"
                   VerticalAlignment="Top"/>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="TitleBlock"
                           FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ManufacturerBlock" Margin="0,8,0,0"/>
                <TextBlock x:Name="CategoryBlock" Margin="0,4,0,0"/>
                <TextBlock x:Name="PriceBlock" Margin="0,8,0,0"
                           FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompositionBlock" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="DescriptionBlock" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="SizeRangeBlock" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" x:Name="OrderPanel" Margin="0,14,0,0">
            <TextBlock Text="Доступные для заказа размеры:" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CbSizes" Width="280" Height="28"
                          VerticalContentAlignment="Center"/>
                <TextBlock Text="Количество, пар:" VerticalAlignment="Center"
                           Margin="15,0,5,0"/>
                <TextBox x:Name="TbQuantity" Width="70" Height="28"
                         VerticalContentAlignment="Center" Text="1"/>
                <Button x:Name="BtnAddToOrder"
                        Content="Добавить в заказ"
                        Width="170" Height="28"
                        Margin="15,0,0,0"
                        Click="BtnAddToOrder_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="GuestNote"
                   Text="Заказ может оформить только авторизованный пользователь."
                   Foreground="#B71C1C" FontWeight="SemiBold"
                   Margin="0,14,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnBack"
                    Content="Назад в каталог"
                    Width="170" Height="32"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>