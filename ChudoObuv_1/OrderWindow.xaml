<Window x:Class="ChudoObuv_1.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа — Чудо-обувь"
        Height="480" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" x:Name="SpClientPick"
                    Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="Клиент:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbClient" Width="360" Height="28"
                      Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TbOrderInfo"
                   FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" x:Name="SpPick"
                    Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="Поиск по наименованию:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbSearch" Width="220" Height="28"
                     VerticalContentAlignment="Center"
                     Margin="10,0,0,0"
                     TextChanged="TbSearch_TextChanged"/>
            <Button x:Name="BtnPick"
                    Content="Выбрать товар"
                    Width="130" Height="28"
                    Margin="15,0,0,0"
                    Click="BtnPick_Click"/>
        </StackPanel>

        <ListBox Grid.Row="3" x:Name="LbProducts"
                 Height="120"
                 DisplayMemberPath="NameProduct"
                 BorderBrush="#CCCCCC" BorderThickness="1"
                 Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <TextBlock Grid.Row="4" Text="Состав заказа:"
                   FontSize="16" FontWeight="Bold"/>

        <DataGrid Grid.Row="5" x:Name="OrderGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding IdOrderItems}"
                                    Width="50"
                                    Visibility="Collapsed"/>
                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding ProductTitle}"
                                    Width="*"/>
                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeName}"
                                    Width="80"/>
                <DataGridTextColumn Header="Кол-во, пар"
                                    Binding="{Binding Quantity}"
                                    Width="90"/>
                <DataGridTextColumn Header="Цена за ед., руб."
                                    Binding="{Binding UnitPrice, StringFormat=N2}"
                                    Width="130"/>
                <DataGridTextColumn Header="Сумма, руб."
                                    Binding="{Binding Sum, StringFormat=N2}"
                                    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TotalText"
                       FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            <Button x:Name="BtnConfirm"
                    Content="Подтвердить заказ"
                    Width="170" Height="32"
                    Click="BtnConfirm_Click"/>
            <Button x:Name="BtnCancel"
                    Content="Отменить заказ"
                    Width="150" Height="32"
                    Margin="10,0,0,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave"
                    Content="Сохранить заказ"
                    Width="150" Height="32"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnDeleteItem"
                    Content="Удалить позицию"
                    Width="140" Height="32"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="BtnDeleteItem_Click"/>
            <Button x:Name="BtnBack"
                    Content="Назад"
                    Width="130" Height="32"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>