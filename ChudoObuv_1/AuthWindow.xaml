<Window x:Class="ChudoObuv_1.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ЧудоОбувь - Авторизация"
        Height="420" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ЧудоОбувь" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Магазин обуви" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="GuestButton" Content="Войти как гость"
                Width="220" Height="42" FontSize="16" Margin="0,0,0,40"
                Click="GuestButton_Click"/>
    </Grid>
</Window>