<Window x:Class="ChudoObuv_1.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Чудо-Обувь"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="260">
            <TextBlock Text="Чудо-Обувь"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5" />
            <TextBlock Text="Вход в систему"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />

            <TextBlock Text="Логин:" Margin="0,0,0,5" />
            <TextBox x:Name="TbLogin" Height="28" />

            <Button Content="Войти"
                    Height="32"
                    Margin="0,15,0,0"
                    Click="BtnLogin_Click" />

            <Button Content="Войти как гость"
                    Height="32"
                    Margin="0,10,0,0"
                    Click="BtnGuest_Click" />
        </StackPanel>
    </Grid>
</Window>